# Private key untuk deployer (tanpa 0x)
PRIVATE_KEY=your_private_key_here

# Alamat kontrak USDC (Stablecoin)
# BASE MAINNET: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# BASE SEPOLIA: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=0x...

# Alamat admin Verity (untuk kontrol sistem)
ADMIN_ADDRESS=0x...

# Alamat layanan Oracle/Validator (Pengganti fungsi CRE di Base)
CRE_ADDRESS=0x...

# (Optional) API Key untuk verifikasi kontrak (Basescan)
ETHERSCAN_API_KEY=your_api_key_here
